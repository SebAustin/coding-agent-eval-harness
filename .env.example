# Copy to .env and fill in values: cp .env.example .env

# Required for `coding-eval build-dataset` (GitHub API rate limits)
GITHUB_TOKEN=

# Required for Claude Code adapter and semantic rubric judge
ANTHROPIC_API_KEY=

# Required if you run the Aider or OpenAI Codex adapters
OPENAI_API_KEY=

# Optional: LangSmith tracing when LANGSMITH_API_KEY is set
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coding-agent-eval-harness
